# PostgreSQL chạy bằng docker compose (xem docker-compose.yml)
DATABASE_URL="postgresql://invoice:invoice@localhost:5432/invoice?schema=public"
# Kết nối trực tiếp cho prisma migrate. Local: giống DATABASE_URL.
# Trên Vercel + Neon: DATABASE_URL = URL pooled (thêm ?pgbouncer=true), DIRECT_URL = URL unpooled
DIRECT_URL="postgresql://invoice:invoice@localhost:5432/invoice?schema=public"

# ===== Chế độ chạy =====
# true  => gọi Mock Viettel server nội bộ (/api/mock-viettel), không cần tài khoản thật
# false => gọi Viettel S-Invoice 2.0 thật (sandbox/production)
VIETTEL_MOCK_MODE=true

# URL của chính app (dùng làm base URL cho Mock server).
# Trên Vercel: để trống, app tự dùng VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL
APP_URL=http://localhost:3000

# ===== Bảo vệ khi deploy công khai (Vercel) =====
# Đặt cả 2 biến => toàn bộ UI + API yêu cầu HTTP Basic Auth (trừ mock server và cron)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Vercel Cron gửi header "Authorization: Bearer $CRON_SECRET" tới /api/cron/reconcile
CRON_SECRET=

# ===== Viettel S-Invoice 2.0 =====
# Hệ thống test (mục 7.1 tài liệu): web https://vinvoice.viettel.vn
# API: {BASE_URL}/auth/login và {BASE_URL}/services/einvoiceapplication/api/...
VIETTEL_BASE_URL=https://api-vinvoice.viettel.vn
# Tài khoản test dạng <MST>-<số>, vd 0100109106-509 (mật khẩu: liên hệ đầu mối tích hợp Viettel)
VIETTEL_USERNAME=demo-user
VIETTEL_PASSWORD=demo-password
# MST người bán: [0-9-], tối đa 20 ký tự (vd 0312770607 hoặc 0312770607-001).
# Trong ví dụ của tài liệu, MST người bán trùng username (vd username 0100109106-712 → supplierTaxCode 0100109106-712)
VIETTEL_SUPPLIER_TAX_CODE=0100109106
# Mẫu số (TT78, vd 1/001) — tối đa 20 ký tự; Ký hiệu [a-zA-Z0-9/] tối đa 25 ký tự (vd C24TAA)
# Loại hóa đơn TT78: 1-6 (1 = Hóa đơn GTGT)
VIETTEL_TEMPLATE_CODE=1/770
VIETTEL_INVOICE_SERIES=K23TXM
VIETTEL_INVOICE_TYPE=1

# Timeout mỗi request ra Viettel (ms). Tài liệu khuyến nghị 60-90s (app ép tối thiểu 60s);
# chỉ gửi lại cùng transactionUuid sau >= 90s. Mock dùng timeout ngắn để demo
VIETTEL_TIMEOUT_MS=90000
VIETTEL_MOCK_TIMEOUT_MS=5000
